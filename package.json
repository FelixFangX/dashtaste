{
  "name": "dashtaste",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "dashtaste": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint-skills": "vitest run test/skills.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gallery": "pnpm build && node gallery/build.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^20.19.0",
    "echarts": "^6.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  },
  "optionalDependencies": {
    "playwright-core": "^1.56.0"
  }
}
