{
  "name": "dashtaste",
  "version": "0.0.1",
  "description": "Dashboard taste for coding agents: two style-pack skills (global and cn) plus a dashtaste check linter for ECharts configs and rendered dashboards.",
  "keywords": [
    "dashboard",
    "echarts",
    "chart",
    "lint",
    "linter",
    "data-visualization",
    "dataviz",
    "design",
    "agent-skills",
    "skills",
    "ai-agents",
    "cli"
  ],
  "author": "Felix Fang (https://github.com/FelixFangX)",
  "homepage": "https://github.com/FelixFangX/dashtaste#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixFangX/dashtaste.git"
  },
  "bugs": {
    "url": "https://github.com/FelixFangX/dashtaste/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "dashtaste": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint-skills": "vitest run test/skills.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gallery": "pnpm build && node gallery/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^20.19.0",
    "echarts": "^6.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~3.2.4"
  },
  "optionalDependencies": {
    "playwright-core": "^1.56.0"
  }
}
