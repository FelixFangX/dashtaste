{
  "ruleset": "dt-2026.2",
  "synthetic": true,
  "guards": "Live review() JSON for these cases, and id, name, basis, rationale, severity, and packs for every rule. The comparison is the reports, not a hash of the source.",
  "doesNotGuard": [
    "Older ruleset ids are not executable.",
    "Cases are representative synthetic inputs, not every branch and not captured customer dashboards.",
    "A score is not a quality certificate.",
    "Browser copy and rendered pixels are outside this file.",
    "Editing this file in place under the same ruleset id would hide a behavior change. Replace it only together with a new ruleset id."
  ],
  "rules": [
    {
      "id": "DT001",
      "name": "default-palette",
      "basis": "heuristic",
      "rationale": "ECharts default colours are a theme. Using them does not make the series false.",
      "severity": "error",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT002",
      "name": "rainbow-palette",
      "basis": "heuristic",
      "rationale": "Many hues are harder to separate. The chart can still encode the categories.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT003",
      "name": "smooth-line",
      "basis": "heuristic",
      "rationale": "Smoothing can be a legitimate interpolation. A hit is not proof the chart invented data.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT004",
      "name": "symbols-everywhere",
      "basis": "heuristic",
      "rationale": "Point markers are a density choice. A marked series can still be the right chart.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT005",
      "name": "pie-slices",
      "basis": "heuristic",
      "rationale": "A slice cap is a reading aid, not a ban on pies.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT006",
      "name": "pie-overuse",
      "basis": "heuristic",
      "rationale": "Preferring bars is a recommendation. One pie can be the right comparison.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT007",
      "name": "three-d",
      "basis": "heuristic",
      "rationale": "A 3D mark often distorts a 2D comparison, and it is valid for some spatial data. Severity stays error.",
      "severity": "error",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT008",
      "name": "dual-axis",
      "basis": "heuristic",
      "rationale": "Two value axes can be the right pair of units.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT009",
      "name": "missing-unit",
      "basis": "heuristic",
      "rationale": "A unitless index is a valid axis. Naming the unit is advice.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT010",
      "name": "bar-baseline",
      "basis": "constraint",
      "rationale": "A bar encodes amount by length from zero. A positive min or scale:true changes that ratio.",
      "severity": "error",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT011",
      "name": "raw-large-numbers",
      "basis": "heuristic",
      "rationale": "Compact formatting is easier to read. The raw values are still the data.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT012",
      "name": "unit-system",
      "basis": "heuristic",
      "rationale": "万/亿 versus K/M is the selected pack convention, not a universal unit.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT013",
      "name": "delta-convention",
      "basis": "heuristic",
      "rationale": "Up and down colours follow a pack or page convention, not a physical fact. Severity stays error.",
      "severity": "error",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT014",
      "name": "delta-colour-only",
      "basis": "constraint",
      "rationale": "The extracted delta uses hue alone, with no arrow or sign.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT015",
      "name": "low-contrast-text",
      "basis": "constraint",
      "rationale": "Text contrast is below 4.5:1, or below 3:1 for large or bold text, against the colour this rule compares.",
      "severity": "error",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT016",
      "name": "thin-line-contrast",
      "basis": "constraint",
      "rationale": "The line colour is below 3:1 against the chart background.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT017",
      "name": "gradient-decoration",
      "basis": "heuristic",
      "rationale": "A gradient is decoration, not a broken encoding.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT018",
      "name": "glow",
      "basis": "heuristic",
      "rationale": "Glow is decoration.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT019",
      "name": "kpi-overload",
      "basis": "taste",
      "rationale": "The cap is the selected taste's max KPIs, or a tighter overlay. It is not a universal limit.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT020",
      "name": "kpi-rainbow",
      "basis": "heuristic",
      "rationale": "Several accent colours compete. They do not make a number false.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT021",
      "name": "emoji-icons",
      "basis": "heuristic",
      "rationale": "Emoji are inconsistent iconography, not invalid text.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT022",
      "name": "cjk-min-size",
      "basis": "heuristic",
      "rationale": "12px is this pack's CJK floor, not a universal type minimum.",
      "severity": "warn",
      "packs": [
        "cn"
      ]
    },
    {
      "id": "DT023",
      "name": "legend-single-series",
      "basis": "heuristic",
      "rationale": "A one-series legend repeats the title. It is still a valid legend.",
      "severity": "info",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT024",
      "name": "bar-width",
      "basis": "heuristic",
      "rationale": "The pixel cap is a layout preference.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT025",
      "name": "legend-not-direct-label",
      "basis": "heuristic",
      "rationale": "Direct labels are a recommendation for two to four lines.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT026",
      "name": "line-weight",
      "basis": "heuristic",
      "rationale": "Widths outside 1–3px are a house range.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT027",
      "name": "tabular-numerals",
      "basis": "heuristic",
      "rationale": "Tabular figures help alignment. Proportional figures are still the numbers.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT028",
      "name": "hero-metric",
      "basis": "heuristic",
      "rationale": "A size hierarchy is advice about emphasis.",
      "severity": "info",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT029",
      "name": "helper-captions",
      "basis": "heuristic",
      "rationale": "A narrating caption is redundant here. It is not a false statement.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT030",
      "name": "taste-rainbow",
      "basis": "taste",
      "rationale": "Every named taste treats a rainbow palette as an error for that school.",
      "severity": "error",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT031",
      "name": "taste-chart-cap",
      "basis": "taste",
      "rationale": "Chart count is compared with the selected taste's cap.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT032",
      "name": "taste-series-cap",
      "basis": "taste",
      "rationale": "Series count is compared with the selected taste's cap.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT033",
      "name": "taste-annotation",
      "basis": "taste",
      "rationale": "Annotation count is compared with the selected taste's range.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT034",
      "name": "taste-motion",
      "basis": "taste",
      "rationale": "Motion on or off follows the selected taste.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT035",
      "name": "taste-ground",
      "basis": "taste",
      "rationale": "Background luminance is compared with the selected taste's ground.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT036",
      "name": "taste-currency",
      "basis": "taste",
      "rationale": "A currency mark is required only by tastes that ask for one.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT037",
      "name": "taste-funnel",
      "basis": "taste",
      "rationale": "Funnel count and stage order follow the selected taste.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    },
    {
      "id": "DT038",
      "name": "taste-palette",
      "basis": "taste",
      "rationale": "Colour and hue caps are the selected taste's, and can be tighter than DT002.",
      "severity": "warn",
      "packs": [
        "global",
        "cn"
      ]
    }
  ],
